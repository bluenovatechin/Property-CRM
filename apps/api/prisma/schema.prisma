// Property Management CRM — database schema (SRS section 6).
// Money columns are NUMERIC(12,2). Business records use soft delete (deletedAt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  FINANCE
  STAFF
  OWNER
  TENANT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  OFFICE
  SHOP
  WAREHOUSE
  MIXED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum TenantType {
  INDIVIDUAL
  COMPANY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  PREVIOUS
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  RENEWED
  TERMINATED
}

enum RentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
  CARD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  VENDOR
  SALARY
  TAX
  INSURANCE
  ADMIN
  OTHER
}

enum NotificationStatus {
  UNREAD
  READ
}

enum TokenType {
  INVITE
  RESET
}

model Company {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  owners     Owner[]
  properties Property[]
  tenants    Tenant[]
}

model User {
  id             String               @id @default(uuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  name           String
  email          String               @unique
  phone          String?
  passwordHash   String?
  role           Role
  status         UserStatus           @default(ACTIVE)
  failedLogins   Int                  @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  ownerId        String?              @unique
  owner          Owner?               @relation(fields: [ownerId], references: [id])
  tenantId       String?              @unique
  tenant         Tenant?              @relation(fields: [tenantId], references: [id])
  // Staff / finance person who works for one owner (sees only that owner's properties)
  teamOwnerId    String?
  teamOwner      Owner?               @relation("OwnerTeam", fields: [teamOwnerId], references: [id])
  propertyAccess UserPropertyAccess[]
  refreshTokens  RefreshToken[]
  authTokens     AuthToken[]
  assignedTickets MaintenanceRequest[] @relation("TicketAssignee")
  raisedTickets  MaintenanceRequest[] @relation("TicketRaisedBy")
  ticketComments MaintenanceComment[]
  rentEntries    RentEntry[]          @relation("RentEnteredBy")
  notifications  Notification[]
  activity       ActivityLog[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
}

model UserPropertyAccess {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Owner {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  name        String
  phone       String
  email       String?
  address     String?
  pan         String?
  bankAccount String?
  ifsc        String?
  notes       String?
  user        User?
  team        User[]     @relation("OwnerTeam")
  tenants     Tenant[]
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
}

model Property {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  code         String
  name         String
  type         PropertyType
  addressLine1 String
  addressLine2 String?
  area         String?
  city         String
  state        String
  pincode      String
  ownerId      String
  owner        Owner                @relation(fields: [ownerId], references: [id])
  status       PropertyStatus       @default(ACTIVE)
  notes        String?
  units        Unit[]
  tickets      MaintenanceRequest[]
  expenses     Expense[]
  access       UserPropertyAccess[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?

  @@unique([companyId, code])
  @@index([ownerId])
}

model Unit {
  id              String               @id @default(uuid())
  propertyId      String
  property        Property             @relation(fields: [propertyId], references: [id])
  unitNo          String
  floor           Int?
  block           String?
  unitType        String
  areaSqft        Int?
  expectedRent    Decimal              @db.Decimal(12, 2)
  securityDeposit Decimal              @db.Decimal(12, 2)
  status          UnitStatus           @default(VACANT)
  vacantSince     DateTime?
  notes           String?
  leases          Lease[]
  rentEntries     RentEntry[]
  tickets         MaintenanceRequest[]
  expenses        Expense[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@unique([propertyId, unitNo])
  @@index([status])
}

model Tenant {
  id             String               @id @default(uuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  type           TenantType           @default(INDIVIDUAL)
  fullName       String
  phone          String
  altPhone       String?
  email          String?
  address        String?
  idType         String?
  idNumber       String?
  emergencyName  String?
  emergencyPhone String?
  status         TenantStatus         @default(INACTIVE)
  notes          String?
  // The owner this tenant belongs to (set when an owner adds them, or by their first lease)
  ownerId        String?
  owner          Owner?               @relation(fields: [ownerId], references: [id])
  user           User?
  leases         Lease[]
  rentEntries    RentEntry[]
  tickets        MaintenanceRequest[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  @@unique([companyId, phone])
  @@index([fullName])
}

model Lease {
  id                String      @id @default(uuid())
  unitId            String
  unit              Unit        @relation(fields: [unitId], references: [id])
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  startDate         DateTime    @db.Date
  endDate           DateTime    @db.Date
  monthlyRent       Decimal     @db.Decimal(12, 2)
  securityDeposit   Decimal     @db.Decimal(12, 2)
  dueDay            Int         @default(5)
  noticeDays        Int         @default(30)
  escalationPct     Decimal     @default(0) @db.Decimal(5, 2)
  renewalTerms      String?
  status            LeaseStatus @default(DRAFT)
  previousLeaseId   String?
  previousLease     Lease?      @relation("LeaseRenewal", fields: [previousLeaseId], references: [id])
  renewals          Lease[]     @relation("LeaseRenewal")
  terminatedOn      DateTime?   @db.Date
  terminationReason String?
  rentEntries       RentEntry[]
  payments          Payment[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, endDate])
  @@index([unitId])
  @@index([tenantId])
}

// One rent entry per lease per month, entered manually by the owner (confirmed decision).
model RentEntry {
  id          String              @id @default(uuid())
  leaseId     String
  lease       Lease               @relation(fields: [leaseId], references: [id])
  unitId      String
  unit        Unit                @relation(fields: [unitId], references: [id])
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  period      String // YYYY-MM
  amount      Decimal             @db.Decimal(12, 2)
  dueDate     DateTime            @db.Date
  status      RentStatus          @default(PENDING)
  paidOn      DateTime?           @db.Date
  mode        PaymentMode?
  reference   String?
  notes       String?
  enteredById String
  enteredBy   User                @relation("RentEnteredBy", fields: [enteredById], references: [id])
  allocations PaymentAllocation[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([leaseId, period])
  @@index([status, dueDate])
  @@index([period])
}

// Reserved for the payment module (partial payments, receipts, online payment),
// to be built later by the senior developer. Not used by the MVP.
model Payment {
  id          String              @id @default(uuid())
  leaseId     String
  lease       Lease               @relation(fields: [leaseId], references: [id])
  amount      Decimal             @db.Decimal(12, 2)
  paymentDate DateTime            @db.Date
  mode        PaymentMode
  referenceNo String?
  receiptNo   String              @unique
  status      String              @default("SUCCESS")
  allocations PaymentAllocation[]
  createdAt   DateTime            @default(now())
}

model PaymentAllocation {
  id          String    @id @default(uuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id])
  rentEntryId String
  rentEntry   RentEntry @relation(fields: [rentEntryId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
}

model MaintenanceRequest {
  id            String               @id @default(uuid())
  ticketNo      Int                  @unique @default(autoincrement())
  propertyId    String
  property      Property             @relation(fields: [propertyId], references: [id])
  unitId        String?
  unit          Unit?                @relation(fields: [unitId], references: [id])
  tenantId      String?
  tenant        Tenant?              @relation(fields: [tenantId], references: [id])
  category      String
  title         String
  description   String
  priority      Priority             @default(MEDIUM)
  status        TicketStatus         @default(OPEN)
  assignedToId  String?
  assignedTo    User?                @relation("TicketAssignee", fields: [assignedToId], references: [id])
  vendorName    String?
  estimatedCost Decimal?             @db.Decimal(12, 2)
  actualCost    Decimal?             @db.Decimal(12, 2)
  slaDueAt      DateTime
  resolvedAt    DateTime?
  closedAt      DateTime?
  raisedById    String
  raisedBy      User                 @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  comments      MaintenanceComment[]
  expenses      Expense[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([propertyId])
  @@index([assignedToId])
}

model MaintenanceComment {
  id        String             @id @default(uuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  comment   String
  oldStatus TicketStatus?
  newStatus TicketStatus?
  createdAt DateTime           @default(now())
}

model Expense {
  id                   String              @id @default(uuid())
  propertyId           String
  property             Property            @relation(fields: [propertyId], references: [id])
  unitId               String?
  unit                 Unit?               @relation(fields: [unitId], references: [id])
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  category             ExpenseCategory
  amount               Decimal             @db.Decimal(12, 2)
  expenseDate          DateTime            @db.Date
  paidTo               String?
  mode                 PaymentMode?
  notes                String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  @@index([propertyId, expenseDate])
}

// Metadata only; files live in object storage (Phase 2).
model Document {
  id           String    @id @default(uuid())
  companyId    String
  entityType   String
  entityId     String
  category     String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  expiryDate   DateTime? @db.Date
  isSensitive  Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([entityType, entityId])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  status    NotificationStatus @default(UNREAD)
  emailedAt DateTime?
  dedupeKey String?            @unique
  createdAt DateTime           @default(now())

  @@index([userId, status])
}

model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  summary    String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([companyId, createdAt])
}
