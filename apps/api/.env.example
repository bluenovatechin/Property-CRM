# Copy this file to .env and adjust.

# Local development uses the embedded PostgreSQL started by `npm run db:start` (port 5433).
# In production, use your Neon / Supabase / RDS connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/property_crm?schema=public"

PORT=3000
NODE_ENV=development

# Where the web app runs (used in email links and CORS)
APP_URL="http://localhost:5174"

# Use long random strings in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Email. Leave SMTP_HOST empty in development: emails are printed to the API console instead.
# Resend example: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<api key>
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Property CRM <no-reply@example.com>"

# Timezone used for due dates and the daily jobs
TZ_NAME="Asia/Kolkata"
